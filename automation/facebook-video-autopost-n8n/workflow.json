    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst next = rows.find(r => !r['Trạng thái'] || String(r['Trạng thái']).trim() === '');\nreturn next ? [{ json: next }] : [];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1400, 300],
      "id": "code-pick-next-product",
      "name": "Chọn sản phẩm tiếp theo"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Bạn là chuyên gia sáng tạo nội dung video ngắn cho thương hiệu quà tặng dát vàng cao cấp V&T Gold / ACT Gold (quatangdatvang.com). Cho sản phẩm dưới đây, hãy viết:\n\n1. Một dòng chữ ngắn (overlay_text) tối đa 45 ký tự, gây ấn tượng, sẽ hiện đè lên video slideshow ảnh sản phẩm (không dùng dấu ngoặc kép, không icon).\n2. Một đoạn caption đầy đủ (caption) để đăng kèm video lên Facebook: 100-180 từ, giọng thân thiện, sang trọng vừa phải, nêu bật giá trị/ý nghĩa món quà, kết thúc mời khách inbox tư vấn, KHÔNG dùng hashtag, KHÔNG bịa số điện thoại.\n\nTrả về ĐÚNG định dạng JSON trong khối ```json```, không thêm chữ nào khác:\n```json\n{\n  \"overlay_text\": \"...\",\n  \"caption\": \"...\"\n}\n```\n\nThông tin sản phẩm:\nTên: {{ $json['Tên sản phẩm'] }}\nLink: {{ $json['Link sản phẩm'] }}\n",
        "hasOutputParser": true
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [-1180, 300],
      "id": "llm-write-video-copy",
      "name": "Viết caption & chữ trên video",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.0-flash-001",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [-1092, 520],
      "id": "gemini-model-video",
      "name": "Gemini - Viết video copy",
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Gemini API - VTGold"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let rawText = $json.text || '';\n\nconst matched = rawText.match(/```json\\s*([\\s\\S]*?)\\s*```/);\nconst source = matched && matched[1] ? matched[1] : rawText;\n\nlet jsonString = source\n  .replace(/\\n/g, '')\n  .replace(/\\r/g, '')\n  .replace(/\\t/g, '')\n  .trim();\n\ntry {\n  const parsed = JSON.parse(jsonString);\n  return [{\n    json: {\n      overlay_text: parsed.overlay_text || '',\n      caption: parsed.caption || ''\n    }\n  }];\n} catch (err) {\n  return [{\n    json: { overlay_text: '', caption: '', error: 'Lỗi parse JSON: ' + err.message }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-804, 300],
      "id": "code-parse-video-copy",
      "name": "Tách JSON caption"
    },
    {
      "parameters": {
        "jsCode": "const product = $('Chọn sản phẩm tiếp theo').item.json;\nconst ai = $json;\n\nconst images = ['Ảnh 1', 'Ảnh 2', 'Ảnh 3', 'Ảnh 4', 'Ảnh 5']\n  .map(col => product[col])\n  .filter(Boolean);\n\nif (images.length === 0) {\n  throw new Error('Sản phẩm \"' + product['Tên sản phẩm'] + '\" chưa có ảnh trong Sheet (cột Ảnh 1..5).');\n}\n\nconst modifications = {};\nimages.forEach((url, idx) => {\n  modifications[`Image-${idx + 1}.source`] = url;\n});\nmodifications['Text-ProductName.text'] = product['Tên sản phẩm'];\nmodifications['Text-Overlay.text'] = ai.overlay_text;\nmodifications['Text-CTA.text'] = 'V&T Gold - Qua tang dat vang cao cap';\n\nreturn [{\n  json: {\n    body: {\n      template_id: 'YOUR_CREATOMATE_TEMPLATE_ID',\n      modifications,\n      webhook_url: 'https://YOUR_N8N_DOMAIN/webhook/creatomate-video-done',\n      metadata: JSON.stringify({\n        row_key: product['Link sản phẩm'],\n        product_name: product['Tên sản phẩm'],\n        caption: ai.caption\n      })\n    },\n    row_key: product['Link sản phẩm']\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-584, 300],
      "id": "code-build-creatomate-request",
      "name": "Chuẩn bị dữ liệu gửi Creatomate"
    },
