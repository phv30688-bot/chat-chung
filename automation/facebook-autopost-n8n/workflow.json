      "parameters": {
        "jsCode": "let rawText = $json.text || '';\n\nconst matched = rawText.match(/```json\\s*([\\s\\S]*?)\\s*```/);\nconst source = matched && matched[1] ? matched[1] : rawText;\n\nlet jsonString = source\n  .replace(/\\n/g, '')\n  .replace(/\\r/g, '')\n  .replace(/\\t/g, '')\n  .trim();\n\ntry {\n  const parsed = JSON.parse(jsonString);\n  return [{\n    json: {\n      prompt_image: parsed.prompt_image || '',\n      content: parsed.content || ''\n    }\n  }];\n} catch (err) {\n  return [{\n    json: {\n      prompt_image: '',\n      content: '',\n      error: 'Lỗi parse JSON: ' + err.message\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
